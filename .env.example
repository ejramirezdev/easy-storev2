# =============================================================================
# Easy Store — variables de entorno (ejemplo)
# =============================================================================
# Copia este archivo a `.env.local` en la raíz del proyecto y rellena los valores.
#
# Dónde recuperar valores tras perder el .env:
# - Hosting (Vercel, Railway, etc.): Environment Variables del proyecto
# - Base de datos: panel del proveedor (connection string)
# - Google OAuth: Google Cloud Console → APIs & Services → Credentials
# - AWS: IAM → usuario con claves de acceso; S3 → nombre del bucket
# - Payphone: panel de comercio / documentación de integración
# - SMTP: proveedor de correo (p. ej. contraseña de aplicación de Gmail)
#
# NEXTAUTH_SECRET (si no lo guardaste, crea uno nuevo; invalida sesiones previas):
#   npm run generate:nextauth-secret
#   (equivalente: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
#
# En producción se validan DATABASE_URL, NEXTAUTH_SECRET y Google OAuth
# (ver lib/config.ts → validateConfig).
# =============================================================================

# --- Base de datos (obligatorio en producción) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
# Opcionales (pool / timeouts)
# DB_CONNECTION_LIMIT=1
# DB_CONNECT_TIMEOUT=30
# DB_POOL_TIMEOUT=30

# --- NextAuth / sesión (obligatorio en producción) ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generar_con_node_crypto_ver_comentario_arriba"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- URLs públicas del sitio ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_DOMAIN="localhost"

# --- Marca y contacto (NEXT_PUBLIC_* se inyectan en el cliente) ---
# NEXT_PUBLIC_COMPANY_NAME="Easy Store"
# NEXT_PUBLIC_COMPANY_EMAIL=""
# NEXT_PUBLIC_COMPANY_PHONE=""
# NEXT_PUBLIC_COMPANY_WHATSAPP=""
# NEXT_PUBLIC_COMPANY_ADDRESS=""
# NEXT_PUBLIC_INSTAGRAM_URL=""
# NEXT_PUBLIC_FACEBOOK_URL=""
# NEXT_PUBLIC_TWITTER_URL=""

# --- Paginación y límites ---
# NEXT_PUBLIC_PRODUCTS_PER_PAGE=12
# NEXT_PUBLIC_FEATURED_PRODUCTS_LIMIT=6
# NEXT_PUBLIC_RELATED_PRODUCTS_LIMIT=10
# NEXT_PUBLIC_ORDERS_PER_PAGE=10
# ADMIN_USERS_LIMIT=100
# API_TIMEOUT=30000

# --- Admin ---
# ADMIN_OWNER_EMAIL=""
# ADMIN_DEFAULT_EMAILS="email1@example.com,email2@example.com"

# --- AWS S3 (lib/config.ts usa AWS_S3_BUCKET; lib/s3.ts usa AWS_S3_BUCKET_NAME) ---
AWS_REGION="us-east-1"
AWS_S3_BUCKET=""
AWS_S3_BUCKET_NAME=""
AWS_S3_BUCKET_URL=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# --- Correo (SMTP) ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
# Alternativas reconocidas por el código:
# EMAIL_USER=""
# EMAIL_PASSWORD=""
SMTP_FROM=""
# EMAIL_FROM=""
# EMAIL_REPLY_TO=""
# EMAIL_NOTIFICATIONS_TO=""

# --- Payphone ---
PAYPHONE_ENVIRONMENT="sandbox"
PAYPHONE_TOKEN=""
PAYPHONE_STORE_ID=""
PAYPHONE_RESPONSE_URL=""
PAYPHONE_MERCHANT_NAME=""
PAYPHONE_MERCHANT_EMAIL=""
PAYPHONE_CURRENCY="USD"
PAYPHONE_CONFIRM_SECRET=""
# PAYPHONE_CONFIRMATION_TIMEOUT=5

# --- SEO ---
# NEXT_PUBLIC_SEO_DEFAULT_TITLE=""
# NEXT_PUBLIC_SEO_DEFAULT_DESCRIPTION=""

# --- Analytics ---
# NEXT_PUBLIC_GA_ID=""
# NEXT_PUBLIC_GTM_ID=""
